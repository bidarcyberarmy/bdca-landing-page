---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Achievements from '../components/Achievements.astro';
import SubWebHub from '../components/SubWebHub.astro';
import Structure from '../components/Structure.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
---

<Layout 
  title={`${siteConfig.fullName} (${siteConfig.shortName}) - Independent Cyber Security Community`}
  description={siteConfig.description}
>
  <Navbar />
  
  <main id="main-content">
    <Hero />
    <About />
    <Structure />
    <Achievements />
    <SubWebHub />
  </main>

  <Footer />
</Layout>
