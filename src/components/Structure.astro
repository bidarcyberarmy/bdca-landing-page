---
import MemberCard from './MemberCard.astro';
import { rosterPeriod, teamGroups } from '../data/team';
import { copy } from '../data/copy';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { roster } = copy[locale];

const [leadership, ...divisions] = teamGroups;
const memberCount = teamGroups.reduce((total, group) => total + group.members.length, 0);
const groupIcons: Partial<Record<(typeof teamGroups)[number]['id'], string>> = {
  education: 'M12 7v14M3 5c3-2 6-2 9 0 3-2 6-2 9 0v14c-3-2-6-2-9 0-3-2-6-2-9 0V5Z',
  software: 'm8 6-6 6 6 6m8-12 6 6-6 6m-2-15-4 18',
  creative: 'm16 4 4 4M4 20l4-1 12-12a2.8 2.8 0 0 0-4-4L4 15l-1 6 1-1Z',
  relations: 'M15 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2m18 0v-2a4 4 0 0 0-3-3.9M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm5-3.9a4 4 0 0 1 0 7.8',
};
---

<section id="members" class="roster wrap" aria-labelledby="roster-title">
  <svg class="roster-gradients" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="roster-wave-back" x2="100%" y2="45%">
        <stop stop-color="#81a4d4" />
        <stop offset="54%" stop-color="#617795" />
        <stop offset="100%" stop-color="#90abcf" />
      </linearGradient>
      <linearGradient id="roster-wave-front" x2="0%" y2="100%">
        <stop stop-color="#6983ae" />
        <stop offset="48%" stop-color="#365682" />
        <stop offset="100%" style="stop-color: var(--roster-caption)" />
      </linearGradient>
    </defs>
  </svg>
  <div class="roster-top">
    <div class="roster-intro">
      <p class="eyebrow">03 / {roster.kicker}</p>
      <h2 class="display-title" id="roster-title">{roster.title}<br /><span class="accent">{roster.accent}</span></h2>
      <p class="roster-description">{roster.description}</p>
      <ul class="roster-stats" role="list">
        <li>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={groupIcons.relations} />
          </svg>
          {memberCount} {roster.people}
        </li>
        <li>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" />
          </svg>
          {teamGroups.length} {roster.groups}
        </li>
      </ul>
    </div>

    <section class="leadership" aria-labelledby="leadership-title">
      <div class="leadership-intro">
        <p class="leadership-period">{rosterPeriod}</p>
        <h3 id="leadership-title">{leadership.name[locale]}</h3>
        <p class="leadership-description">{leadership.description[locale]}</p>
      </div>
      <ul class="leadership-members" role="list">
        {leadership.members.map((member) => <MemberCard {member} {locale} compact />)}
      </ul>
    </section>
  </div>

  <div class="divisions">
    {divisions.map((group) => (
      <section
        class:list={['division', { 'division-education': group.id === 'education' }]}
        aria-labelledby={`division-${group.id}`}
      >
        <header class="division-header">
          <span class="division-icon" aria-hidden="true">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
              <path d={groupIcons[group.id]} />
            </svg>
          </span>
          <div class="division-copy">
            <h3 id={`division-${group.id}`}>{group.name[locale]}</h3>
            <p>{group.description[locale]}</p>
          </div>
          <span class="division-count">{group.members.length} {roster.members}</span>
        </header>
        <ul class="division-members" role="list">
          {group.members.map((member) => <MemberCard {member} {locale} />)}
        </ul>
      </section>
    ))}
  </div>
  <p class="roster-note">BDCA © 2026 / Universitas Bina Darma</p>
</section>

<style>
  .roster {
    --panel-gap: clamp(.75rem, 1.2vw, 1.15rem);
    --panel-fill: linear-gradient(145deg, #f8fafe 12%, #f6f8fe 61%, #f4f8fe);
    --panel-radius: 1.2rem;
    --heading-gradient: linear-gradient(95deg, #1151d8, #105ee7 54%, #1889f4);
    --roster-caption: #1b3661;
    padding-block-end: var(--section-space);
  }
  .roster-gradients { position: absolute; }
  .roster-top {
    display: grid;
    align-items: stretch;
    gap: clamp(1.2rem, 2.2vw, 2.25rem);
    margin-bottom: clamp(1rem, 2.1vw, 2rem);
  }
  .roster-intro { min-width: 0; align-self: center; }
  .roster-intro .eyebrow { margin-bottom: .85rem; }
  .roster-intro h2 {
    font-size: clamp(1.85rem, 3.55vw, 3.55rem);
    overflow-wrap: anywhere;
  }
  .roster-description {
    margin-top: 1rem;
    max-width: 34rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .roster-stats, .leadership-members, .division-members {
    list-style: none;
    padding: 0;
  }
  .roster-stats {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-top: 1.15rem;
  }
  .roster-stats li {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .44rem .72rem;
    border: 1px solid var(--line);
    border-radius: 2rem;
    background: linear-gradient(160deg, #f7f9ff, #dfecfd);
    font-size: .8125rem;
    font-weight: 700;
  }
  .roster-stats svg { color: var(--accent-deep); }
  .leadership {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--panel-radius);
    background: var(--panel-fill);
  }
  .leadership-intro {
    display: grid;
    align-content: center;
    gap: .75rem;
    padding: clamp(1rem, 1.8vw, 1.75rem);
    color: #fff;
    background: linear-gradient(135deg, #214880, #113060 53%, #335585);
  }
  .leadership-period {
    font-size: .72rem;
    font-weight: 700;
    color: #dbe9fc;
    letter-spacing: .105em;
  }
  .leadership h3 {
    font-size: clamp(1.45rem, 2vw, 2.1rem);
    letter-spacing: -.045em;
    text-wrap: balance;
  }
  .leadership-description {
    max-width: 28ch;
    color: #e2edfc;
    font-size: .875rem;
    text-wrap: pretty;
  }
  .leadership-members, .division-members { display: grid; gap: .65rem; }
  .leadership-members {
    --portrait-height: clamp(12.75rem, 19vw, 18.5rem);
    --portrait-fit: cover;
    --portrait-pos: 50% 16%;
    --portrait-mask: none;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: var(--panel-gap);
  }
  .divisions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--panel-gap);
  }
  .division {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    padding: var(--panel-gap);
    border: 1px solid var(--line);
    border-radius: var(--panel-radius);
    background: var(--panel-fill);
    box-shadow: 0 2px 3px #18447e0b;
  }
  .division-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-content: start;
    align-items: start;
    gap: .45rem .65rem;
    margin-bottom: .75rem;
    min-height: 5.2rem;
  }
  .division-icon {
    display: grid;
    place-items: center;
    width: clamp(2.35rem, 3.2vw, 2.85rem);
    aspect-ratio: 1;
    grid-row: span 2;
    border-radius: .75rem;
    background: linear-gradient(135deg, #1a5dc2, #103876 55%, #0e2957);
    color: #fff;
  }
  .division-copy { display: contents; }
  .division-copy h3 {
    grid-column: 2 / -1;
    font-size: clamp(1rem, 1.37vw, 1.225rem);
    letter-spacing: -.035em;
    overflow-wrap: anywhere;
  }
  .division-copy p {
    color: var(--muted);
    font-size: .775rem;
    line-height: 1.38;
    text-wrap: pretty;
  }
  .division-count {
    align-self: center;
    padding: .23rem .43rem;
    border-radius: 1rem;
    background: linear-gradient(160deg, #edf4fe, #dae8fd);
    color: #183860;
    font-size: .625rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .division-members {
    --portrait-height: clamp(11.75rem, 15vw, 14rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
  }
  .division-education { --caption-height: 4rem; }
  .roster-note {
    margin-top: .9rem;
    color: var(--muted);
    font-size: .75rem;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  @media (min-width: 880px) {
    .leadership {
      grid-template-columns: minmax(10.25rem, .95fr) minmax(0, 3fr);
      background:
        linear-gradient(102deg, transparent 23%, #f2f6fd 51%, #f4f8fe),
        radial-gradient(ellipse 76% 71% at 62% 133%, #8db3e3 19%, #5690d4 76%, transparent 77%),
        radial-gradient(ellipse 43% 65% at 4% 112%, #4671aa, transparent 85%),
        linear-gradient(106deg, #214880, #113060 17%, #335585 25%, #8db3e3 44%, #f2f6fd 65%);
    }
    .leadership-intro { background: transparent; }
  }
  @media (min-width: 621px) {
    .division:not(.division-education) .division-members { grid-template-columns: minmax(0, 1fr); }
  }
  @media (min-width: 1120px) {
    .roster-top { grid-template-columns: minmax(0, 1fr) minmax(0, 2.55fr); }
    .divisions { grid-template-columns: minmax(0, 1.32fr) repeat(3, minmax(0, 1fr)); }
    .division { grid-row: span 2; grid-template-rows: subgrid; }
    .division-header { margin-bottom: 0; }
  }
  @media (min-width: 1120px) and (max-width: 1320px), (min-width: 621px) and (max-width: 800px) {
    .division-header { grid-template-columns: auto minmax(0, 1fr); min-height: 6rem; }
    .division-icon { grid-row: span 3; }
    .division-count { justify-self: start; align-self: start; }
  }
  @media (max-width: 620px) {
    .divisions { grid-template-columns: minmax(0, 1fr); }
    .division-header { min-height: 0; }
  }
  @media (max-width: 540px) {
    .leadership-members { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 370px) {
    .division-header { grid-template-columns: auto minmax(0, 1fr); }
    .division-icon { grid-row: span 3; }
    .division-count { justify-self: start; }
  }
</style>
