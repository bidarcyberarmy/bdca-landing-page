---
import { copy } from '../data/copy';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { programs } = copy[Astro.props.locale];
---

<section id="programs" class="programs wrap" aria-labelledby="programs-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">02 / {programs.kicker}</p>
      <h2 class="display-title" id="programs-title">{programs.title}<br />{programs.subtitle}</h2>
    </div>
    <p>{programs.intro}</p>
  </div>
  <ol class="program-list" role="list">
    {programs.items.map(({ verb, name, description }, index) => (
      <li>
        <span class="program-index">0{index + 1} — {verb}</span>
        <h3>{name}</h3>
        <p>{description}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .programs { padding-block-end: var(--section-space); }
  .program-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0; list-style: none; border-block: 1px solid var(--line); }
  .program-list li { padding: clamp(1.3rem, 2.1vw, 2.1rem) clamp(1rem, 2.5vw, 2.5rem); }
  .program-list li:first-child { padding-inline-start: 0; }
  .program-list li + li { border-inline-start: 1px solid var(--line); }
  .program-index { color: var(--accent); font-size: .8125rem; text-transform: uppercase; font-weight: 700; }
  h3 { margin-block: 1.1rem .55rem; letter-spacing: -.035em; font-size: clamp(1.2rem, 1.65vw, 1.65rem); }
  li p { max-width: 23rem; color: var(--muted); text-wrap: pretty; }
  @media (min-width: 701px) {
    .program-list li { display: grid; grid-row: span 3; grid-template-rows: subgrid; }
  }
  @media (max-width: 700px) {
    .program-list { grid-template-columns: 1fr; }
    .program-list li { padding-inline: 0; }
    .program-list li + li { border-inline-start: 0; border-block-start: 1px solid var(--line); }
    h3 { margin-block-start: .55rem; }
  }
</style>
