---
import { subWebs } from '../data/subwebs';
---

<section id="subwebs" class="subwebs section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Ecosystem Hub</span>
      <h2 class="section-title">Platforms & Sub-Webs</h2>
      <p class="section-subtitle">
        Akses langsung seluruh ekosistem layanan, platform latihan CTF, virtual lab, dan repositori resmi BDCA.
      </p>
    </div>

    <!-- Sub-Web Cards Grid -->
    <div class="subwebs-grid">
      {subWebs.map((sub) => (
        <article class={`hcs-card subweb-card ${sub.featured ? 'subweb-featured' : ''}`}>
          <div class="card-header">
            <span class="category-tag">{sub.category}</span>
            <span class={`status-pill status-${sub.status}`}>
              <span class="status-dot" aria-hidden="true"></span>
              <span>{sub.statusLabel}</span>
            </span>
          </div>

          <div class="card-body">
            <h3 class="card-title">
              <a href={sub.url} target="_blank" rel="noopener noreferrer" class="title-link">
                {sub.title}
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </h3>
            <p class="card-desc">{sub.description}</p>
          </div>

          <div class="card-footer">
            <div class="tags-row" aria-label="Tags">
              {sub.tags.map((tag) => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>

            <a 
              href={sub.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class={`btn-visit ${sub.status === 'maintenance' ? 'btn-visit-secondary' : 'btn-visit-primary'}`}
              aria-label={`Buka platform ${sub.title}`}
            >
              <span>{sub.status === 'maintenance' ? 'Status Pemeliharaan' : 'Kunjungi Platform'}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .subwebs {
    border-top: 1px solid var(--border-subtle);
  }

  .subwebs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .subweb-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .subweb-featured {
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .category-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--cyan-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-body {
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .card-title {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-primary);
  }

  .title-link:hover {
    color: var(--cyan-accent);
  }

  .external-icon {
    opacity: 0.6;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .title-link:hover .external-icon {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .card-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
  }

  .btn-visit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.84375rem;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-align: center;
  }

  .btn-visit-primary {
    background-color: rgba(59, 130, 246, 0.12);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .btn-visit-primary:hover {
    background-color: var(--blue-primary);
    color: #ffffff;
    border-color: var(--blue-primary);
  }

  .btn-visit-secondary {
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .btn-visit-secondary:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
  }
</style>
