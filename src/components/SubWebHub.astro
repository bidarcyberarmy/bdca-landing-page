---
import { subWebs } from '../data/subwebs';
---

<ul class="resources" role="list">
  {subWebs.map((resource) => (
    <li>
      <div>
        <p class="eyebrow">{resource.category}</p>
        <h2>{resource.title}</h2>
        <p>{resource.description}</p>
      </div>
      {resource.status === 'online' ? (
        <a class="text-link" href={resource.url} rel="noopener noreferrer">
          Open portal <span class="sr-only">{resource.title}</span><span aria-hidden="true">↗</span>
        </a>
      ) : <span class="resource-status">{resource.status === 'internal' ? 'Internal' : 'Under maintenance'}</span>}
    </li>
  ))}
</ul>
