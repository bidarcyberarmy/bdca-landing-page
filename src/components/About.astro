---
import { copy } from '../data/copy';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { about } = copy[Astro.props.locale];
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <div>
    <p class="eyebrow">01 / {about.kicker}</p>
    <h2 class="display-title" id="about-title">{about.title}<br /><span class="accent">{about.accent}</span></h2>
  </div>
  <div class="about-copy">
    <p class="eyebrow">Bina Darma Cyber Army</p>
    <p class="intro">{about.description}</p>
    <ul class="topics" role="list">
      {about.topics.map((topic) => <li>{topic}</li>)}
    </ul>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, .84fr) minmax(0, 1.16fr); padding-block: var(--section-space); }
  .about .eyebrow { margin-block-end: .85rem; }
  .about-copy { border-inline-start: 1px solid var(--line); padding-inline-start: clamp(1.75rem, 4vw, 4rem); }
  .intro { color: var(--muted); font-size: clamp(1.05rem, 1.36vw, 1.35rem); line-height: 1.6; max-width: 40rem; text-wrap: pretty; }
  .topics { display: flex; flex-wrap: wrap; gap: .55rem .65rem; list-style: none; padding: 0; margin-block-start: 1.2rem; }
  .topics li { border: 1px solid var(--line); border-radius: 2rem; padding: .58rem 1rem; font-size: .8125rem; background: linear-gradient(110deg, #f9fcff, #e8f3fe); }
  @media (max-width: 700px) {
    .about { grid-template-columns: 1fr; gap: 1.35rem; }
    .about-copy { border-inline-start: 0; border-block-start: 1px solid var(--line); padding: 1.15rem 0 0; }
  }
</style>
