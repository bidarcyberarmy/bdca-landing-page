---
import { copy } from '../data/copy';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { bdcahoot } = copy[Astro.props.locale];
---

<section id="bdcahoot" class="project wrap" aria-labelledby="bdcahoot-title">
  <div class="project-panel">
    <div class="project-intro">
      <p class="eyebrow">{bdcahoot.label}</p>
      <h2 id="bdcahoot-title" class="display-title">BDCAHOOT</h2>
      <p class="project-description">{bdcahoot.description}</p>
    </div>

    <div class="event-info">
      <h3>{bdcahoot.event}</h3>
      <p>{bdcahoot.access}</p>
      <div class="project-actions">
        <details>
          <summary class="text-link">
            {bdcahoot.how} <span class="arrow" aria-hidden="true">→</span>
          </summary>
          <ol>
            {bdcahoot.steps.map((step) => <li>{step}</li>)}
          </ol>
        </details>
        <a class="text-link repo-link" href="https://github.com/alifaguslerian/BDCAHOOT-live">
          {bdcahoot.github} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .project {
    margin-block-end: clamp(1rem, 1.8vw, 1.5rem);
  }

  .project-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(1.25rem, 4vw, 4rem);
    background: #e7f3fc;
  }

  .project-intro {
    border-inline-start: .25rem solid var(--accent-bright);
    padding-inline-start: clamp(.9rem, 2.4vw, 2rem);
  }

  .project-intro h2 {
    margin-block: .65rem .85rem;
    font-size: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  .project-description {
    max-width: 40ch;
    font-size: clamp(1rem, 1.65vw, 1.35rem);
    text-wrap: pretty;
  }

  .event-info {
    container-type: inline-size;
    border-block: 1px solid #8da6c1;
    padding-block: clamp(.85rem, 1.7vw, 1.4rem);
  }

  .event-info h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    letter-spacing: -.035em;
  }

  .event-info p {
    margin-block: .55rem .35rem;
    color: var(--muted);
  }

  .project-actions {
    --repo-width: 8.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--repo-width);
    align-items: start;
    column-gap: .75rem;
  }

  .project-actions .text-link { color: var(--accent); }
  .project-actions .text-link:hover { text-decoration: underline; }
  .project-actions details {
    grid-column: 1 / -1;
    grid-row: 1;
  }
  .repo-link {
    grid-area: 1 / 2;
    justify-self: start;
    z-index: 1;
  }

  summary {
    list-style: none;
    width: fit-content;
    max-width: calc(100% - var(--repo-width) - .75rem);
    cursor: pointer;
  }

  summary::-webkit-details-marker { display: none; }
  details[open] .arrow { transform: rotate(90deg); }

  ol {
    margin-block-start: .5rem;
    padding-inline-start: 1.25rem;
    color: var(--muted);
  }

  li + li { margin-block-start: .25rem; }

  @container (max-width: 16.5rem) {
    .project-actions { display: block; }
    summary { max-width: 100%; }
    .repo-link { margin-block-start: .125rem; }
  }

  @media (max-width: 700px) {
    .project-panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
    }
  }
</style>
