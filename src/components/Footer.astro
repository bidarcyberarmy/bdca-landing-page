---
import { siteConfig } from '../data/site';
import { copy } from '../data/copy';
import { pagePath, type Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { footer, nav } = copy[locale];
const home = pagePath(locale);
---

<footer id="contact" class="site-footer">
  <div class="wrap wrap-wide footer-inner">
    <div class="footer-brand">
      <a href={home} aria-label={footer.home}>
        <img
          src="/assets/bdca-full-footer-210.webp"
          srcset="/assets/bdca-full-footer-210.webp 210w, /assets/bdca-full-footer.webp 420w"
          sizes="auto, clamp(9.25rem, 13.5vw, 13.125rem)"
          width="420" height="190" alt="" loading="lazy" decoding="async"
        />
      </a>
      <p>Universitas Bina Darma · Palembang, Indonesia</p>
    </div>
    <nav aria-label={footer.exploreLabel}>
      <h2>{footer.explore}</h2>
      <a href={`${home}#community`}>{nav.community}</a>
      <a href={`${home}#programs`}>{footer.learning}</a>
      <a href={pagePath(locale, 'ecosystem')} id="subwebs">{footer.software}</a>
      <a href={pagePath(locale, 'activities')} id="achievements">{footer.activities}</a>
    </nav>
    <nav aria-label={footer.findLabel}>
      <h2>{footer.find}</h2>
      <a href={siteConfig.links.github} rel="noopener noreferrer">GitHub</a>
      <a href={siteConfig.links.instagram} rel="noopener noreferrer">Instagram</a>
      <a href={siteConfig.url} rel="noopener noreferrer">bidarcyberarmy.org</a>
      <a href={`mailto:${siteConfig.contact.email}`}>{footer.email}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-block-start: 1px solid var(--line); padding-block: clamp(1.6rem, 2.7vw, 2.65rem); }
  .footer-inner { display: grid; grid-template-columns: 1.2fr 1fr .85fr; align-items: start; gap: 1.5rem 1.75rem; }
  .footer-brand > a { display: inline-block; min-height: 44px; }
  .footer-brand img { width: clamp(9.25rem, 13.5vw, 13.125rem); height: auto; }
  .footer-brand p, nav a { color: var(--muted); font-size: .875rem; }
  .footer-brand p { margin-block-start: .45rem; text-wrap: pretty; }
  nav { display: grid; justify-items: start; align-content: start; }
  nav h2 { text-transform: uppercase; letter-spacing: .075em; font-size: .8125rem; margin-block-end: .7rem; }
  nav a { padding-block: .2rem; }
  nav a:hover { color: var(--accent); text-decoration: underline; }
  @media (max-width: 700px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 1.75rem 1rem; }
    .footer-brand { grid-column: 1 / -1; }
    nav a { display: flex; align-items: center; min-height: 44px; }
  }
</style>
