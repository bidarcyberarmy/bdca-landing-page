---
import { achievements } from '../data/achievements';
import { siteConfig } from '../data/site';
---

<section id="achievements" class="achievements section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Track Record</span>
      <h2 class="section-title">Our Proud Achievements</h2>
      <p class="section-subtitle">
        Catatan keikutsertaan dan prestasi kompetisi Capture The Flag (CTF) serta riset keamanan siber tim BDCA.
      </p>
    </div>

    <!-- Achievements Grid -->
    <div class="achievements-grid">
      {achievements.map((item) => (
        <article class="hcs-card achievement-card">
          <div class="card-header">
            <span class="cat-pill">{item.category}</span>
            <span class="date-text">{item.date}</span>
          </div>

          <h3 class="achievement-title">{item.title}</h3>

          {item.rank && (
            <div class="rank-badge">
              <span class="rank-icon" aria-hidden="true">&bull;</span>
              <span>{item.rank}</span>
            </div>
          )}

          {item.teamName && (
            <p class="team-name">
              <span>Team: </span>
              <strong>{item.teamName}</strong>
            </p>
          )}

          {item.description && (
            <p class="achievement-desc">{item.description}</p>
          )}
        </article>
      ))}
    </div>

    <div class="ctftime-cta">
      <p class="ctftime-text">Pantau riwayat turnamen global kami secara langsung di CTFtime:</p>
      <a 
        href={siteConfig.links.ctftime} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-hcs-outline"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M24 0v24H0V0zm-3.077 3.077L7.067 3.076 16 12.816 10.369 19l-2.195-2.612 3.476-3.573-8.574-9.609v17.717h17.847z"/></svg>
        <span>View BDCA on CTFtime</span>
      </a>
    </div>
  </div>
</section>

<style>
  .achievements {
    border-top: 1px solid var(--border-subtle);
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .achievement-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cat-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--cyan-accent);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-xs);
    text-transform: uppercase;
  }

  .date-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .achievement-title {
    font-size: 1.15rem;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: #34d399;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    width: fit-content;
  }

  .rank-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .team-name {
    font-size: 0.84375rem;
    color: var(--text-muted);
  }

  .team-name strong {
    color: var(--text-secondary);
  }

  .achievement-desc {
    font-size: 0.84375rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-top: auto;
  }

  .ctftime-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .ctftime-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
</style>
