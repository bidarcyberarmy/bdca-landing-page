---
import type { TeamMember } from '../data/team';

interface Props {
  member: TeamMember;
  compact?: boolean;
}

const { member, compact = false } = Astro.props;
---

<li class:list={['member-card', { compact }]}>
  <img
    class:list={['portrait', { placeholder: !member.avatar }]}
    src={member.avatar ?? '/assets/team/placeholder.svg'}
    width="116"
    height="144"
    loading="lazy"
    decoding="async"
    alt=""
  />
  <div class="member-info">
    <svg class="card-wave" viewBox="0 0 320 34" preserveAspectRatio="none" aria-hidden="true">
      <path fill="url(#roster-wave-back)" d="M0 15C57-14 111 0 165 18S257 37 320 10V34H0Z" />
      <path fill="url(#roster-wave-front)" d="M0 24C60 1 105 10 162 23S253 39 320 22V34H0Z" />
    </svg>
    <p class="member-name">{member.name}</p>
    <p class="member-role">{member.role}</p>
  </div>
</li>

<style>
  .member-card {
    display: flex;
    align-items: end;
    min-width: 0;
    min-height: var(--portrait-height, 11.25rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: .9rem;
    background: linear-gradient(132deg, #c6cfde, #c3ccdc 52%, #becadd);
  }
  .portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder { height: 69%; object-fit: contain; }
  .member-info {
    position: relative;
    width: 100%;
    min-height: var(--caption-height, 3.75rem);
    padding: .55rem clamp(.55rem, 1vw, .95rem) .65rem;
    background: linear-gradient(180deg, var(--roster-caption), #173059);
    color: #fff;
  }
  .card-wave {
    position: absolute;
    inset: auto 0 calc(100% - 1px);
    width: 100%;
    height: clamp(.95rem, 2.4vw, 1.8rem);
  }
  .member-name {
    font-size: clamp(.875rem, 1.12vw, 1.0625rem);
    font-weight: 700;
    line-height: 1.19;
    letter-spacing: -.022em;
    overflow-wrap: anywhere;
  }
  .member-role {
    margin-top: .25rem;
    color: #e1ebfb;
    font-size: clamp(.75rem, .9vw, .875rem);
    line-height: 1.32;
    overflow-wrap: anywhere;
  }
  @media (max-width: 540px) {
    .compact {
      display: grid;
      grid-template-columns: clamp(4.75rem, 23vw, 6.75rem) minmax(0, 1fr);
      align-items: stretch;
      min-height: 5.75rem;
    }
    .compact .portrait { position: static; height: 100%; }
    .compact .placeholder { padding: .3rem; }
    .compact .member-info { display: grid; align-content: center; padding: .65rem .85rem; }
    .compact .card-wave { display: none; }
  }
</style>
