---
import { siteConfig } from '../data/site';
---

<header class="header">
  <div class="navbar-island">
    <!-- Brand Logo (Left) -->
    <a href="#" class="brand" aria-label="BDCA Beranda">
      <img src="/assets/logo-emblem.webp" alt="BDCA Official Emblem" width="32" height="32" decoding="async" class="brand-logo" />
      <span class="brand-name">BDCA</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav" aria-label="Navigasi Utama">
      <ul class="nav-list">
        <li><a href="#" class="nav-item">Beranda</a></li>
        <li><a href="#about" class="nav-item">Tentang</a></li>
        <li><a href="#members" class="nav-item">Anggota</a></li>
        <li><a href="#achievements" class="nav-item">Pencapaian</a></li>
        <li><a href="#subwebs" class="nav-item">Ekosistem</a></li>
      </ul>
    </nav>

    <!-- Right Actions -->
    <div class="header-right">
      <a href="#subwebs" class="btn-portal">
        <span class="portal-text">Portal Hub</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
      
      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-toggle" class="mobile-toggle" aria-label="Toggle Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="mobile-menu">
    <ul class="mobile-nav-list">
      <li><a href="#" class="mobile-nav-item">Beranda</a></li>
      <li><a href="#about" class="mobile-nav-item">Tentang</a></li>
      <li><a href="#members" class="mobile-nav-item">Anggota</a></li>
      <li><a href="#achievements" class="mobile-nav-item">Pencapaian</a></li>
      <li><a href="#subwebs" class="mobile-nav-item">Ekosistem</a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 2rem;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
    padding: 0 1rem;
  }

  .navbar-island {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 
      0 10px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    padding: 0.65rem 0.75rem 0.65rem 1.75rem;
    gap: 2rem;
    width: 95%;
    max-width: 1100px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .navbar-island:hover {
    background: rgba(15, 23, 42, 0.65);
    box-shadow: 
      0 15px 50px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    transition: transform 0.3s ease;
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.4));
  }

  .brand:hover .brand-logo {
    transform: rotate(5deg) scale(1.1);
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.02em;
    font-family: var(--font-sans);
  }

  .nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .nav-item:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-portal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue-primary);
    color: white;
    padding: 0.6rem 1.25rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
  }

  .btn-portal:hover {
    background: var(--blue-hover);
    transform: translateY(-1px);
    box-shadow: 0 0 25px rgba(59, 130, 246, 0.5);
  }

  /* Mobile Components */
  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.5rem;
    pointer-events: auto;
    border-radius: 8px;
    transition: background 0.2s ease;
  }
  .mobile-toggle:hover {
    background: rgba(255,255,255,0.1);
  }
  
  .mobile-menu {
    position: absolute;
    top: calc(100% + 1rem);
    left: 1rem;
    right: 1rem;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px) scale(0.98);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  
  .mobile-menu.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .mobile-nav-item {
    display: block;
    padding: 1rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    border-radius: 12px;
    transition: background 0.2s ease;
  }
  .mobile-nav-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    
    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .portal-text {
      display: none;
    }
    
    .btn-portal {
      padding: 0.6rem;
    }
    
    .navbar-island {
      padding: 0.5rem 0.5rem 0.5rem 1.25rem;
      gap: 1rem;
    }
  }
</style>

<script is:inline>
  "use strict";
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("mobile-toggle");
    const menu = document.getElementById("mobile-menu");
    const links = document.querySelectorAll(".mobile-nav-item");

    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        menu.classList.toggle("is-active");
      });

      links.forEach(link => {
        link.addEventListener("click", () => {
          menu.classList.remove("is-active");
        });
      });
    }
  });
</script>
