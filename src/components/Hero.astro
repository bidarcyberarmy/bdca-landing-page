---
import { copy } from '../data/copy';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { hero } = copy[Astro.props.locale];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content wrap">
    <p class="hero-kicker">{hero.kicker}</p>
    <h1 id="hero-title">{hero.title}<br /><span class="accent">{hero.accent}</span></h1>
    <p class="hero-description">{hero.description}</p>
    <div class="hero-actions">
      <a class="button" href="#about">{hero.about} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#programs">{hero.programs} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="globe-stage">
    <div class="globe" data-globe>
      <div class="globe-visual" aria-hidden="true">
        <img class="globe-poster" src="/assets/cloud-globe.webp"
          srcset="/assets/cloud-globe-small.webp 480w, /assets/cloud-globe-640.webp 640w, /assets/cloud-globe.webp 768w"
          sizes="(max-width: 700px) min(88vw, 32rem), (max-width: 900px) min(62vw, 37rem), min(45vw, 40rem)"
          width="768" height="768" alt="" fetchpriority="high" decoding="async" />
        <svg class="globe-orbit" width="700" height="700" viewBox="0 0 700 700" fill="none">
          <ellipse cx="355" cy="331" rx="370" ry="80" transform="rotate(-24 355 331)" stroke="#6195e5" stroke-opacity=".27" />
        </svg>
      </div>
    </div>
    <div class="globe-aside">
      <p class="coordinates" aria-label="Palembang, Indonesia">
        02° 58′ S<br />104° 45′ E<br /><span>Palembang, ID</span>
      </p>
      <button class="globe-toggle" type="button" data-globe-toggle data-pause={hero.pause} data-loading={hero.loading} data-unavailable={hero.unavailable} hidden>
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M17 10a7 7 0 1 1-2-4.9L17 7m0-4v4h-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{hero.rotate}</span>
      </button>
    </div>
  </div>

  <div class="hero-strip">
    <div class="wrap wrap-wide strip-inner">
      <strong>BDCA / Bina Darma Cyber Army</strong>
      {hero.strip.map((message) => <span>{message}</span>)}
      <a href="#about" aria-label={hero.scroll}>↓</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; }
  .hero::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--header-height)) 0 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 73% 78% at 49% -11%, #f9fcfff5 49%, #eff7fce0 67%, #eaf7fc70 67.2%, transparent 68%),
      radial-gradient(ellipse 43% 36% at 1% 56%, #a9eff5b8, transparent 100%),
      radial-gradient(ellipse 42% 35% at 94% 47%, #a3bff3b5, transparent 100%);
  }
  .hero-content { text-align: center; padding-block-start: clamp(2.25rem, 3vw, 3rem); position: relative; z-index: 1; }
  .hero-kicker {
    display: inline-block; padding: .53rem 1rem; border-radius: 2rem; background: linear-gradient(105deg, #d1f4fc, #d7e8ff 62%, #c9e7fb);
    color: #1f3d65; font-size: .7rem; letter-spacing: .115em; font-weight: 700; text-transform: uppercase;
  }
  h1 { margin-block: .85rem 1.15rem; font-size: clamp(2.5rem, 5.15vw, 5.15rem); letter-spacing: -.06em; line-height: 1.065; font-weight: 700; text-wrap: balance; }
  .hero-description { max-width: 37rem; margin-inline: auto; color: var(--muted); font-size: clamp(1rem, 1.125vw, 1.125rem); text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .35rem 1.35rem; justify-content: center; align-items: center; margin-block-start: 1.45rem; }
  .globe-stage {
    position: relative; height: clamp(13rem, 20vw, 20rem); isolation: isolate; overflow: hidden;
    background: radial-gradient(ellipse 45% 132% at 50% 117%, #b7d8fb 0, #d3e9ff9c 53%, transparent 100%);
  }
  .globe {
    width: min(45vw, 40rem); aspect-ratio: 1; position: absolute; top: clamp(1.5rem, 2.3vw, 2.3rem); left: 50%; translate: -50% 0;
  }
  .globe-visual, .globe-poster, .globe-orbit { position: absolute; inset: 0; width: 100%; height: 100%; }
  .globe-orbit { overflow: visible; pointer-events: none; }
  .globe :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .globe-aside { position: absolute; inset: auto var(--gutter) .45rem auto; text-align: left; }
  .coordinates { color: #526b8d; font-size: .72rem; line-height: 1.8; letter-spacing: .12em; text-transform: uppercase; }
  .coordinates span { display: block; margin-block-start: .8rem; }
  .globe-toggle {
    min-height: 44px; display: inline-flex; align-items: center; gap: .35rem; background: transparent; color: #405577;
    border: 0; border-radius: .25rem; padding-inline: .3rem; cursor: pointer; font-size: .75rem;
  }
  .globe-toggle:hover { color: var(--accent); }
  .hero-strip { border-block-start: 1px solid var(--line); background: linear-gradient(100deg, #f4f8fe, #f8fbff 55%, #edf6fe); }
  .strip-inner {
    min-height: clamp(3.5rem, 4.9vw, 4.9rem); display: flex; justify-content: space-between;
    align-items: center; gap: 1rem; font-size: .8125rem; color: var(--muted);
  }
  .strip-inner strong { color: #26364d; text-transform: uppercase; }
  .strip-inner a { display: grid; place-items: center; min-height: 44px; min-width: 44px; color: var(--ink); font-weight: 700; }
  @media (max-width: 900px) {
    .globe { width: min(62vw, 37rem); }
    .strip-inner > span:nth-last-child(2) { display: none; }
  }
  @media (max-width: 700px) {
    .hero-kicker { font-size: .625rem; }
    h1 { font-size: clamp(2rem, 7.1vw, 3.1rem); letter-spacing: -.055em; }
    .hero-description { max-width: 29rem; }
    .hero-actions { margin-block-start: 1.15rem; }
    .coordinates, .strip-inner > span { display: none; }
    .globe { width: min(88vw, 32rem); }
    .globe-stage { height: clamp(10.75rem, 43vw, 17rem); }
    .globe-aside { inset-inline-end: .6rem; inset-block-end: .3rem; }
    .globe-toggle { background: var(--paper); padding-inline: .5rem; }
    .strip-inner { min-height: 3.5rem; }
  }
</style>

<script>
  const globe = document.querySelector<HTMLElement>('[data-globe]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-globe-toggle]');
  const label = toggle?.querySelector('span');

  if (globe && toggle && label && 'WebGLRenderingContext' in window) {
    toggle.hidden = false;
    const rotateLabel = label.textContent;
    const { pause, loading: loadingLabel, unavailable: unavailableLabel } = toggle.dataset;
    let rotation: Awaited<ReturnType<typeof import('../scripts/globe').createGlobe>> = null;
    let playing = false;
    let unavailable = false;
    let loading = false;

    function showUnavailable() {
      unavailable = true;
      toggle?.setAttribute('aria-disabled', 'true');
      if (label) label.textContent = unavailableLabel ?? null;
    }
    globe.addEventListener('globe-unavailable', showUnavailable);

    toggle.addEventListener('click', async () => {
      if (loading || unavailable) return;
      if (!rotation) {
        loading = true;
        toggle.setAttribute('aria-busy', 'true');
        label.textContent = loadingLabel ?? null;
        try {
          const { createGlobe } = await import('../scripts/globe');
          rotation = await createGlobe(globe);
        } catch {
          rotation = null;
        }
        loading = false;
        toggle.removeAttribute('aria-busy');
        if (!rotation) {
          showUnavailable();
          return;
        }
      }

      playing = !playing;
      rotation.setPlaying(playing);
      label.textContent = playing ? pause ?? null : rotateLabel;
    });
  }
</script>
