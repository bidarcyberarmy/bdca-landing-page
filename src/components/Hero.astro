---
import { siteConfig } from '../data/site';
---

<section class="hero section">
  <div class="container hero-container">
    <!-- Left: Floating Community Logo (Inspired by HCS animate-float) -->
    <div class="hero-logo-wrap">
      <img 
        src="/assets/logo-emblem.webp" 
        alt="BDCA Official Emblem" 
        width="220" 
        height="220" 
        fetchpriority="high"
        decoding="async"
        class="hero-logo animate-float" 
      />
    </div>

    <!-- Right: Community Bio & Heading -->
    <div class="hero-content">
      <div class="hero-badge">
        <span class="est-tag">EST. {siteConfig.established}</span>
        <span class="badge-sep" aria-hidden="true">/</span>
        <span>{siteConfig.motto}</span>
      </div>

      <h1 class="hero-title">
        Bina Darma Cyber Army
      </h1>

      <p class="hero-description">
        <strong>BDCA</strong> is an independent cyber security and IT community founded in {siteConfig.established}, mostly consists of 
        <a href="https://binadarma.ac.id" target="_blank" rel="noopener noreferrer" class="univ-link">Universitas Bina Darma</a> 
        students focused on ethical hacking, CTF competitions, and vulnerability research. Under the guidance of faculty mentor <strong>{siteConfig.mentor}</strong>.
      </p>

      <!-- Quick Action Buttons -->
      <div class="hero-actions">
        <a href="#subwebs" class="btn-hcs-primary">
          <span>Explore Ecosystem</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href={siteConfig.links.ctftime} target="_blank" rel="noopener noreferrer" class="btn-hcs-outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M24 0v24H0V0zm-3.077 3.077L7.067 3.076 16 12.816 10.369 19l-2.195-2.612 3.476-3.573-8.574-9.609v17.717h17.847z"/></svg>
          <span>CTFtime Team</span>
        </a>
      </div>

      <!-- Quick Info Meta -->
      <div class="hero-meta">
        <span class="meta-item">
          <strong>Established:</strong> Since {siteConfig.established} (15+ Years)
        </span>
        <span class="meta-dot" aria-hidden="true">&bull;</span>
        <span class="meta-item">
          <strong>Faculty Mentor:</strong> {siteConfig.mentor}
        </span>
        <span class="meta-dot" aria-hidden="true">&bull;</span>
        <span class="meta-item">
          <strong>Affiliation:</strong> Universitas Bina Darma
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .hero-container {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-logo-wrap {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
  }

  .hero-logo {
    width: clamp(160px, 20vw, 240px);
    height: auto;
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.4));
  }

  .hero-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--cyan-accent);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  .est-tag {
    color: #ffffff;
    font-weight: 700;
  }

  .badge-sep {
    color: var(--border-bright);
  }

  .hero-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 660px;
  }

  .hero-description strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .univ-link {
    color: var(--text-primary);
    font-weight: 600;
    border-bottom: 1px solid var(--blue-primary);
  }

  .univ-link:hover {
    color: var(--cyan-accent);
    border-color: var(--cyan-accent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.84375rem;
    color: var(--text-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .hero-meta strong {
    color: var(--text-secondary);
  }

  .meta-dot {
    color: var(--border-bright);
  }

  @media (max-width: 860px) {
    .hero-container {
      flex-direction: column;
      text-align: center;
      gap: 2.5rem;
    }

    .hero-content {
      align-items: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-meta {
      justify-content: center;
    }
  }
</style>
