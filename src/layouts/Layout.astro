---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { siteConfig } from '../data/site';
import { copy } from '../data/copy';
import { locales, pagePath, type Locale, type Page } from '../data/locales';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page: Page;
}

const { title, description, locale, page } = Astro.props;
const siteURL = Astro.site ?? new URL(siteConfig.url);
const canonicalURL = new URL(pagePath(locale, page), siteURL);
const socialImageURL = new URL(siteConfig.ogImage, siteURL);
const organizationId = new URL('/#organization', siteURL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      "name": siteConfig.fullName,
      "alternateName": siteConfig.shortName,
      "url": siteConfig.url,
      "logo": new URL('/assets/logo-emblem.webp', siteURL).href,
      "description": siteConfig.description[locale],
      "sameAs": [
        siteConfig.links.github,
        siteConfig.links.instagram,
        siteConfig.links.discord,
        siteConfig.links.linkedin
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Palembang",
        "addressCountry": "ID"
      }
    },
    {
      "@type": "WebSite",
      "@id": new URL('/#website', siteURL).href,
      "url": siteURL.href,
      "name": siteConfig.fullName,
      "inLanguage": locales,
      "publisher": {
        "@id": organizationId
      }
    }
  ]
};
const structuredData = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7faff" />
    <meta name="google-site-verification" content="kdWvn-S-qD1eXmdQYLCJ1M5L91nW-YmbHdTiUZZrzC8" />

    <link rel="canonical" href={canonicalURL} />
    {locales.map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(pagePath(language, page), siteURL)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath('en', page), siteURL)} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/webp" href="/assets/bdca-emblem-96.webp" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content={siteConfig.fullName} />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{copy[locale].skip}</a>

    <slot />
    <Analytics />
  </body>
</html>
